# ==========================================================
# Agente Arquiteto de Software - Configurações de Ambiente
# ==========================================================

# Provedor ativo de LLM: "auto", "gemini", "openai", "anthropic", "ollama", "builtin"
# Quando definido como "auto", seleciona o primeiro provedor com chave configurada.
# Se nenhuma chave for fornecida, utiliza o Built-in Expert Engine (offline e gratuito).
LLM_PROVIDER=gemini

# --- Google Gemini / Google Cloud AI (GCA) ---
# Obtenha sua chave gratuita no Google AI Studio: https://aistudio.google.com/app/apikey
# Ou através de sua conta corporativa Google Cloud (GCA) vinculada a um projeto GCP.
# O sistema aceita tanto GEMINI_API_KEY quanto GOOGLE_API_KEY.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ollama Local ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

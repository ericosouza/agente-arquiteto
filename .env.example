# ==============================================================================
# AI Software Architecture Designer — ArchiMate
# Variáveis de Ambiente e Configuração dos Provedores de IA
# ==============================================================================

# Provedor Ativo: "builtin" (padrão, 100% offline e gratuito), "gemini", "openai", "anthropic" ou "ollama"
# Deixe "auto" para detectar automaticamente com base nas chaves preenchidas abaixo.
LLM_PROVIDER=auto

# --- Google Gemini (Opcional - https://aistudio.google.com/) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI (Opcional - https://platform.openai.com/) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude (Opcional - https://console.anthropic.com/) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ollama Local (Opcional - Gratuito / Execução no seu computador) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Servidor ---
DEBUG=False
